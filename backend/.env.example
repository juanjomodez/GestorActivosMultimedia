# Copia este archivo como .env (en la carpeta backend/) y completa los valores.
# El archivo .env NUNCA se sube al repositorio.

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas > Database > Connect > Drivers. Reemplaza <usuario> y <password>.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cloud_media_vault

# --- Cloudinary ---
# Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=cloud-media-vault

# --- Reglas de subida ---
MAX_FILE_SIZE_MB=10
